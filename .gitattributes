# 기본 텍스트 파일 자동 인식
* text=auto

# 소스코드 및 문서는 LF 통일
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 배치 파일
*.bat text eol=crlf
*.cmd text eol=crlf

# 바이너리 파일
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
*.pptx binary